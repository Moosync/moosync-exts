{
    "name": "moosync.youtubedl",
    "version": "0.0.1",
    "icon": "assets/icon.svg",
    "extensionEntry": "ext.wasm",
    "moosyncExtension": true,
    "displayName": "Youtube (No API)",
    "permissions": {
      "hosts": [
        "*.youtube.com",
        "youtube.com",
        "*.googlevideo.com",
        "cipher.moosync.app"
      ],
      "paths": {
        "{CACHE_DIR}/youtube_dl/test": "/downloads"
      }
    }
  }