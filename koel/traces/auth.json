{
  "$schema": "https://raw.githubusercontent.com/Moosync/moodriver/refs/heads/main/schema.json",
  "commands": [
    {
      "type": "performAccountLogin",
      "data": {
        "packageName": "moosync.koel",
        "loginStatus": true,
        "accountId": "0"
      }
    }
  ],
  "requests": [
    {
      "type": "getSecure",
      "data": {
        "key": "koel_username",
        "value": "admin@koel.dev"
      }
    },
    {
      "type": "getSecure",
      "data": {
        "key": "koel_password",
        "value": "KoelIsCool"
      }
    }
  ]
}
