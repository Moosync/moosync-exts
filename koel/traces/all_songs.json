{
  "$schema": "https://raw.githubusercontent.com/Moosync/moodriver/refs/heads/main/schema.json",
  "commands": [
    {
      "type": "requestedPlaylistSongs",
      "data": ["moosync.koel:all_songs", false, null]
    }
  ],
  "requests": [
    {
      "type": "getPreference",
      "data": {
        "key": "koel_instance_url",
        "value": "http://localhost:8000"
      }
    },
    {
      "type": "getPreference",
      "data": {
        "key": "koel_username",
        "value": "admin@koel.dev"
      }
    },
    {
      "type": "getSecure",
      "data": {
        "key": "koel_password",
        "value": "KoelIsCool"
      }
    }
  ]
}
