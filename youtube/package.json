{
  "name": "moosync.youtube",
  "version": "0.0.1",
  "icon": "assets/icon.svg",
  "extensionEntry": "ext.wasm",
  "moosyncExtension": true,
  "displayName": "Youtube",
  "permissions": {
    "hosts": [
      "*.youtube.com",
      "youtube.com",
      "*.googleapis.com"
    ],
    "paths": {
      "./youtube": "/youtube"
    }
  }
}
