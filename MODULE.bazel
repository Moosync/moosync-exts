module(
    name = "sample_ext",
    version = "0.0.1",
)

bazel_dep(name = "extensions_sdk", version = "1.0.0")

# git_override(
#     module_name = "extensions_sdk",
#     branch = "main",
#     remote = "https://github.com/Moosync/extensions-sdk.git",
# )
local_path_override(
    module_name = "extensions_sdk",
    path = "/home/ovenoboyo/projects/moosync/tauri/Moosync/lib/extensions_sdk",
)

bazel_dep(name = "moosync")
git_override(
    module_name = "moosync",
    commit = "c6bf5ea76d6e23ab445e1c52eb543b1e5c0a7ae3",
    remote = "https://github.com/Moosync/Moosync.git",
)

bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.40.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_rust", version = "0.68.1")
bazel_dep(name = "rules_rust_prost", version = "0.68.1")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "aspect_rules_js", version = "2.8.3")
bazel_dep(name = "aspect_rules_ts", version = "3.8.1")
bazel_dep(name = "aspect_rules_py", version = "1.6.6")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "toolchains_protoc", version = "0.3.3")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "wasm32-wasip1",
    ],
    versions = ["1.92.0"],
)
use_repo(rust, "rust_toolchains")

# Go Dependencies
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//soundcloud:go.mod")
use_repo(
    go_deps,
    "com_github_antchfx_htmlquery",
)

go_deps.module_override(
    patch_strip = 1,
    patches = ["//patches:go-colorable.patch"],
    path = "github.com/mattn/go-colorable",
)
go_deps.gazelle_override(
    build_file_generation = "off",
    path = "github.com/mattn/go-colorable",
)
use_repo(
    go_deps,
    "com_github_extism_go_pdk",
    "com_github_moosync_extensions_sdk_wasm_extension_go",
    "com_github_ovenoboyo_scdl_v2",
    "com_github_zackradisic_soundcloud_api",
)

# Python Dependencies
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.11",
    requirements_lock = "//youtube_dl:requirements_lock.txt",
)
use_repo(pip, "pypi")

# Rust Dependencies
crate = use_extension("@rules_rust//crate_universe:extension.bzl", "crate")
crate.from_cargo(
    name = "discord_crates",
    cargo_lockfile = "//discord:Cargo.lock",
    manifests = ["//discord:Cargo.toml"],
)
use_repo(crate, "discord_crates")

crate.from_cargo(
    name = "koel_crates",
    cargo_lockfile = "//koel:Cargo.lock",
    manifests = ["//koel:Cargo.toml"],
)
use_repo(crate, "koel_crates")

crate.from_cargo(
    name = "lastfm_crates",
    cargo_lockfile = "//lastfm:Cargo.lock",
    manifests = ["//lastfm:Cargo.toml"],
)
use_repo(crate, "lastfm_crates")

crate.from_cargo(
    name = "radio_crates",
    cargo_lockfile = "//radio:Cargo.lock",
    manifests = ["//radio:Cargo.toml"],
)
use_repo(crate, "radio_crates")

crate.from_cargo(
    name = "spotify_crates",
    cargo_lockfile = "//spotify:Cargo.lock",
    manifests = ["//spotify:Cargo.toml"],
)
use_repo(crate, "spotify_crates")

crate.from_cargo(
    name = "youtube_crates",
    cargo_lockfile = "//youtube:Cargo.lock",
    manifests = ["//youtube:Cargo.toml"],
)
use_repo(crate, "youtube_crates")

register_toolchains("@rust_toolchains//:all")
