module(
    name = "moosync_ext",
    version = "0.0.1",
)

bazel_dep(name = "extensions_sdk", version = "1.0.0")

local_path_override(
    module_name = "extensions_sdk",
    path = "../extensions-sdk",
)

local_path_override(
    module_name = "moosync",
    path = "../Moosync",
)

bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.47.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_rust", version = "0.68.1")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")


single_version_override(
    module_name = "protobuf",
    version = "33.2",
)

bazel_dep(name = "rules_rust_prost", version = "0.68.1")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "aspect_rules_js", version = "3.1.2")
single_version_override(
    module_name = "aspect_rules_js",
    patch_strip = 1,
    patches = ["//patches:aspect_rules_js_virtual_store_prefix.patch"],
)

bazel_dep(name = "aspect_rules_ts", version = "3.8.10")
bazel_dep(name = "aspect_rules_py", version = "1.11.5")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_nodejs", version = "6.2.0")


# npm packages for JS/TS sample extension (mirrors extensions_sdk sdk_npm)
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "moosync_ext_npm",
    pnpm_lock = "@extensions_sdk//wasm-extension-js:pnpm-lock.yaml",
)
use_repo(npm, "moosync_ext_npm")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
use_repo(node, "nodejs_toolchains")

register_toolchains("@nodejs_toolchains//:all")

# TypeScript toolchain for JS sample extension
rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(
    name = "sdk_npm_typescript",
    ts_version_from = "@extensions_sdk//wasm-extension-js:package.json",
)
use_repo(rules_ts_ext, npm_typescript = "sdk_npm_typescript")

register_toolchains("@npm_typescript//:all")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_target_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "wasm32-wasip1",
        "x86_64-pc-windows-gnu",
    ],
    versions = [
        "1.95.0",
        "nightly/2025-12-16",
    ],
)
use_repo(rust, "rust_toolchains")

include("//:dependencies.MODULE.bazel")

register_toolchains(
    "@rules_rust//rust/private/dummy_cc_toolchain:dummy_cc_wasm32_toolchain",
    "@rust_toolchains//:all",
    "@rules_foreign_cc//toolchains:preinstalled_pkgconfig_toolchain",
    "@extensions_sdk//prost_toolchain:prost_toolchain_wasi",
)

# Configure a hermetic Python toolchain using rules_python.
# This ensures that no system_python is used during protobuf or other target evaluation.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.11",
)
