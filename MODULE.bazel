module(
    name = "moosync_ext",
    version = "0.0.1",
)

# Core Moosync dependencies
bazel_dep(name = "extensions_sdk", version = "1.0.0")
git_override(
    module_name = "extensions_sdk",
    branch = "main",
    remote = "https://github.com/Moosync/extensions-sdk",
)

bazel_dep(name = "moosync")
git_override(
    module_name = "moosync",
    branch = "slint",
    remote = "https://github.com/Moosync/Moosync",
)

# Shared foundation rules
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

single_version_override(
    module_name = "protobuf",
    version = "36.0",
)

register_toolchains(
    "@rules_foreign_cc//toolchains:preinstalled_pkgconfig_toolchain",
    "@extensions_sdk//prost_toolchain:prost_toolchain_wasi",
)

# Language-specific segments
include("//:rust.MODULE.bazel")
include("//:js.MODULE.bazel")
include("//:python.MODULE.bazel")
include("//:go.MODULE.bazel")

# Existing external dependencies include
include("//:dependencies.MODULE.bazel")
